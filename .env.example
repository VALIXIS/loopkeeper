# LoopKeeper Environment Configuration Template
PROJECT_NAME="LoopKeeper API"
API_V1_STR="/api/v1"
AUTH_MODE="production"

# Supabase / Database Settings
SUPABASE_URL="https://your-supabase-instance.supabase.co"
SUPABASE_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
DATABASE_URL="postgresql://postgres:password@localhost:5432/loopkeeper"

# Google Meet / Google Drive Integration Settings
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/integrations/google-meet/callback"
GOOGLE_DRIVE_FOLDER_ID="your_google_drive_folder_id"

# Zoom Integration Settings
ZOOM_CLIENT_ID="your_zoom_client_id"
ZOOM_CLIENT_SECRET="your_zoom_client_secret"
ZOOM_REDIRECT_URI="http://localhost:8000/api/v1/integrations/zoom/callback"
ZOOM_WEBHOOK_SECRET_TOKEN="your_zoom_webhook_secret_token"

# Microsoft Teams / Graph API Settings
MS_TEAMS_CLIENT_ID="your_ms_teams_client_id"
MS_TEAMS_CLIENT_SECRET="your_ms_teams_client_secret"
MS_TEAMS_TENANT_ID="common"
MS_TEAMS_REDIRECT_URI="http://localhost:8000/api/v1/integrations/ms-teams/callback"

# Jira Integration Settings
JIRA_DOMAIN="your-company.atlassian.net"
JIRA_EMAIL="developer@your-company.com"
JIRA_API_TOKEN="your_jira_api_token"
JIRA_PROJECT_KEY="LOOP"

# AI Inference Settings
GEMINI_API_KEY="your_gemini_api_key"
CONFIDENCE_THRESHOLD=0.75
